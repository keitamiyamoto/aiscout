# PostgreSQL connection strings.
# Local: both the same.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aiscout?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/aiscout?schema=public"
# Supabase (Project Settings > Database > Connection string):
#   DATABASE_URL = "Transaction pooler" (port 6543) + "?pgbouncer=true"   ... used by the app (Vercel)
#   DIRECT_URL   = "Direct connection" or "Session pooler" (port 5432)   ... used by prisma migrate

# 公開URL。スプレッドシート / CSV に書く結果URLに使う (例: https://aiscout.vercel.app)
APP_URL=""

# ---- 管理画面 (/admin) の Basic 認証 ----
# ADMIN_PASSWORD が空なら /admin は 404 (無効) になります。
ADMIN_USER="admin"
ADMIN_PASSWORD=""

# ---- 診断結果の Google スプレッドシート転記 (任意) ----
# 未設定なら転記しない (DB には保存される)。
GOOGLE_SHEETS_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
# 省略時は先頭のシート。別のシートに書くなら "シート名!A1"
GOOGLE_SHEETS_RANGE=""
